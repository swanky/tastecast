  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
