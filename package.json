{
  "name": "tastecast",
  "version": "1.0.0",
  "description": "TasteCast: Qloo-grounded matching of brand briefs to disclosed AI characters",
  "scripts": {
    "dev": "tsx src/server.node.ts",
    "start": "tsx src/server.node.ts",
    "precompute": "tsx scripts/precompute.ts",
